<Project>
  <!-- Shared build settings for the two plugins in this repository (OBS, PLCIcons). Each plugin csproj imports
       this file explicitly; examples/hello-csharp stays standalone on purpose, it is the tutorial project.
       Expects the csproj to live in <plugin>/src with plugin.json, locales, LICENSE and NOTICE.md one level up. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- plugin.json's "minMacroGrid" is the oldest Macro Grid the plugin runs on (MAJOR.MINOR.PATCH); Macro Grid and the SDK share one
       version. It must be in the same MAJOR as the SDK this plugin is built against and must not be newer than it (the minor and
       patch may be lower: that is what lets the plugin run on more servers). Raise it when you start to use something added to the SDK
       in a newer MINOR. See docs/using-the-sdk-package.md. -->
  <Target Name="CheckMinMacroGridVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_DeclaredMinMacroGrid>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\plugin.json')), '"minMacroGrid"\s*:\s*"([^"]*)"').Groups[1].Value)</_DeclaredMinMacroGrid>
      <_ThreePart>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_DeclaredMinMacroGrid)', '^\d+\.\d+\.\d+$'))</_ThreePart>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_ThreePart)' == 'True'">
      <_DeclaredMajor>$(_DeclaredMinMacroGrid.Split('.')[0])</_DeclaredMajor>
      <_SdkMajor>$(MacroGridSdkVersion.Split('.')[0])</_SdkMajor>
      <_DeclaredTooNew>$([MSBuild]::VersionGreaterThan('$(_DeclaredMinMacroGrid)', '$(MacroGridSdkVersion)'))</_DeclaredTooNew>
    </PropertyGroup>
    <Error Condition="'$(_ThreePart)' != 'True'"
           Text="plugin.json needs &quot;minMacroGrid&quot; as MAJOR.MINOR.PATCH, for example &quot;$(MacroGridSdkVersion)&quot; (found: '$(_DeclaredMinMacroGrid)')." />
    <Error Condition="'$(_ThreePart)' == 'True' And '$(_DeclaredMajor)' != '$(_SdkMajor)'"
           Text="plugin.json says minMacroGrid $(_DeclaredMinMacroGrid), but the SDK it is built against is $(MacroGridSdkVersion): the MAJOR must be the same." />
    <Error Condition="'$(_ThreePart)' == 'True' And '$(_DeclaredTooNew)' == 'True'"
           Text="plugin.json says minMacroGrid $(_DeclaredMinMacroGrid), which is newer than the SDK it is built against ($(MacroGridSdkVersion))." />
  </Target>

  <ItemGroup>
    <!-- SDK: NuGet by default, sibling checkout with -p:UseLocalSdk=true (see Directory.Build.props and
         docs/using-the-sdk-package.md). Either way the SDK dll stays out of the plugin output: the server
         and every plugin must share the server's copy. -->
    <PackageReference Include="MacroGrid.Plugin.Abstractions" Version="$(MacroGridSdkVersion)"
                      PrivateAssets="all" ExcludeAssets="runtime" Condition="'$(UseLocalSdk)' != 'true'" />
    <ProjectReference Include="$(LocalSdkProject)" Private="false" ExcludeAssets="runtime"
                      Condition="'$(UseLocalSdk)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- plugin.json sits next to the DLL in every build output, so "Install from Folder" can point straight at bin/Debug/net10.0. -->
    <None Include="$(MSBuildProjectDirectory)\..\plugin.json" Link="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Translations (locales/<language>.json) travel with the plugin too. -->
    <None Include="$(MSBuildProjectDirectory)\..\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- License files travel with the plugin: the build output is what gets installed and shared. -->
    <None Include="$(MSBuildProjectDirectory)\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildProjectDirectory)\..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
