{
  "id": "hellogauge",
  "name": "Hello Gauge (widget example)",
  "description": "A custom widget example: an animated gauge that shows any number, drawn on a canvas.",
  "category": "Examples",
  "tags": ["example","widget"],
  "author": "Deccoyi",
  "homepage": "https://github.com/Deccoyi/macro-grid-plugin/tree/main/HelloGauge",
  "version": "0.1.0",
  "minMacroGrid": "1.4.0",
  "entry": "index.js",
  "kind": "js",
  "permissions": ["variables"],
  "widgets": [
    {
      "id": "gauge",
      "name": "Gauge",
      "description": "An animated gauge for any number.",
      "category": "Gauges",
      "entry": "widgets/gauge.js",
      "icon": "widgets/gauge.svg",
      "size": { "w": 2, "h": 2 },
      "fps": 30,
      "interactive": true,
      "settings": [
        { "key": "source", "label": "Value", "kind": "Variable", "description": "The variable the gauge follows. Empty shows the demo value." },
        { "key": "max", "label": "Maximum", "kind": "Number", "default": 100, "min": 1, "max": 100000 },
        { "key": "unit", "label": "Unit", "kind": "Text", "default": "%", "placeholder": "%" },
        { "key": "color", "label": "Color", "kind": "Color", "default": "#38bdf8" }
      ]
    }
  ]
}
