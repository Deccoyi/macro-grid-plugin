<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MacroStation.Plugin.PlcIcons</RootNamespace>
    <AssemblyName>MacroStation.Plugin.PlcIcons</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Proje referansı, macro-station repo'suyla aynı makinede kardeş klasör olduğu için çalışıyor.
         MacroStation.Plugin.Abstractions NuGet paketlenene kadar geçici çözüm (bkz. docs/plugin-authoring.md §3). -->
    <ProjectReference Include="..\..\..\macro-station\src\MacroStation.Plugin.Abstractions\MacroStation.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Her build çıktısında plugin.json DLL'in yanında olsun — "Klasörden Yükle" doğrudan bin/Debug/net10.0'ı gösterebilsin. -->
    <None Include="..\plugin.json" Link="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- License files travel with the plugin: the build output is what gets installed and shared. -->
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- İkonlar DLL içine gömülür — çalışma zamanında ayrı dosya okumaya gerek yok. -->
    <EmbeddedResource Include="icons\*.svg" />
  </ItemGroup>

</Project>
