<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, SDK reference and the files that travel with the plugin: see build/Plugin.props. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Plugin.props" />

  <PropertyGroup>
    <RootNamespace>MacroGrid.Plugin.PlcIcons</RootNamespace>
    <AssemblyName>MacroGrid.Plugin.PlcIcons</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The icons are embedded in the DLL, so no separate file has to be read at run time. -->
    <EmbeddedResource Include="icons\*.svg" />
  </ItemGroup>

</Project>
