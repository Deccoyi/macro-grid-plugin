{
  "id": "weather",
  "name": "WeatherPlugin",
  "description": "A weather widget: the current weather at a place you choose, drawn on a canvas.",
  "category": "Weather",
  "tags": ["weather","widget","forecast"],
  "author": "Deccoyi",
  "homepage": "https://github.com/Deccoyi/macro-grid-plugin/tree/main/WeatherPlugin",
  "version": "0.1.0",
  "minMacroGrid": "1.4.0",
  "entry": "index.js",
  "kind": "js",
  "permissions": ["variables", "http:api.open-meteo.com:443"],
  "widgets": [
    {
      "id": "weather",
      "name": "Weather",
      "description": "The current weather: a picture, the temperature and the wind.",
      "category": "Weather",
      "entry": "widgets/weather.js",
      "icon": "widgets/weather.svg",
      "size": { "w": 2, "h": 2 },
      "fps": 15,
      "settings": [
        { "key": "unit", "label": "Unit", "kind": "Segmented", "default": "C", "options": [ { "value": "C", "label": "°C" }, { "value": "F", "label": "°F" } ] }
      ]
    }
  ]
}
