<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, SDK reference and the files that travel with the plugin: see build/Plugin.props. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Plugin.props" />

  <PropertyGroup>
    <RootNamespace>MacroGrid.Plugin.Sound</RootNamespace>
    <AssemblyName>MacroGrid.Plugin.Sound</AssemblyName>
    <!-- WasapiOut and the CoreAudio device enumeration are Windows-only APIs. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT. The only plugin so far that ships a third-party dependency in its output — see
         THIRD_PARTY_NOTICES.md and licenses/naudio/. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
